---
/**
 * BIT Helpdesk – Unified P&O Reception Form
 * Single form for both Meeting Room Reservation and Parking Lot Request.
 */
import "../../styles/global.css";
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>P&O Reception Form</title>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  </head>
  <body class="bg-base-200 text-base-content min-h-screen">
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
      <div class="absolute top-[10%] left-[5%] w-[380px] h-[380px] rounded-full bg-indigo-500/20 blur-[90px] animate-blob1"></div>
      <div class="absolute bottom-[15%] right-[5%] w-[420px] h-[420px] rounded-full bg-purple-500/15 blur-[100px] animate-blob2"></div>
      <div class="absolute top-[40%] left-[30%] w-[500px] h-[500px] rounded-full bg-blue-500/15 blur-[120px] animate-blob3"></div>
    </div>

    <main class="flex justify-center items-center px-4 py-12 min-h-screen">
      <div class="w-full max-w-xl">
        <div class="card w-full bg-base-100 shadow-2xl border border-base-300/40 backdrop-blur-md">
          <div class="card-body p-6 sm:p-10">
            <div class="flex flex-col items-center text-center mb-8">
              <img
                src="/logo.svg"
                alt="BIT Helpdesk Logo"
                class="w-26 h-26 object-contain logo-img mb-4"
              />
              <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight font-title text-base-content mb-2">
                P&O Reception Form
              </h1>
              <p class="text-sm text-base-content/70 max-w-md">
                Submit a meeting room or parking request.
              </p>
            </div>

            <div id="feedback" class="mb-6" aria-live="polite"></div>

            <form id="ticketForm" class="space-y-5" novalidate>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="form-group flex flex-col gap-1.5">
                  <label for="firstName" class="text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 text-base-content/85">
                    <i data-lucide="user" class="w-4 h-4 text-primary"></i>First Name
                  </label>
                  <input type="text" class="input input-bordered w-full focus:input-primary transition-all duration-200" id="firstName" name="firstName" placeholder="John" autocomplete="given-name" required />
                  <div class="invalid-feedback text-error text-xs hidden items-center gap-1 mt-0.5">
                    <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i>Please enter your first name.
                  </div>
                </div>
                <div class="form-group flex flex-col gap-1.5">
                  <label for="lastName" class="text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 text-base-content/85">
                    <i data-lucide="user" class="w-4 h-4 text-primary"></i>Last Name
                  </label>
                  <input type="text" class="input input-bordered w-full focus:input-primary transition-all duration-200" id="lastName" name="lastName" placeholder="Smith" autocomplete="family-name" required />
                  <div class="invalid-feedback text-error text-xs hidden items-center gap-1 mt-0.5">
                    <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i>Please enter your last name.
                  </div>
                </div>
              </div>

              <div class="form-group flex flex-col gap-1.5">
                <label for="email" class="text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 text-base-content/85">
                  <i data-lucide="mail" class="w-4 h-4 text-primary"></i>Email Address
                </label>
                <input type="email" class="input input-bordered w-full focus:input-primary transition-all duration-200" id="email" name="email" placeholder="john.smith@company.com" autocomplete="email" required />
                <div class="invalid-feedback text-error text-xs hidden items-center gap-1 mt-0.5">
                  <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i>Please enter a valid email.
                </div>
              </div>

              <div class="text-[11px] text-base-content/60 -mt-2">
                Notifications and agent replies are sent to the above email.
              </div>

              <div class="form-group flex flex-col gap-1.5">
                <label for="type" class="text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 text-base-content/85">
                  <i data-lucide="list" class="w-4 h-4 text-primary"></i>Request Type
                </label>
                <select class="select select-bordered w-full focus:select-primary transition-all duration-200" id="type" name="type" required>
                  <option value="Meeting Room Reservation" selected>Meeting Room Reservation</option>
                  <option value="Parking Lot Request">Parking Lot Request</option>
                </select>
              </div>

              <div class="form-group flex flex-col gap-1.5">
                <label for="location" class="text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 text-base-content/85">
                  <i data-lucide="map-pin" class="w-4 h-4 text-primary"></i>Location
                </label>
                <select class="select select-bordered w-full focus:select-primary transition-all duration-200" id="location" name="location" required>
                  <option value="" selected disabled>Select location…</option>
                  <option>Head Office</option>
                  <option>SOHO</option>
                  <option>IYS</option>
                  <option>Glaston</option>
                  <option>Basecamp Glorietta</option>
                </select>
                <div class="invalid-feedback text-error text-xs hidden items-center gap-1 mt-0.5">
                  <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i>Please select a location.
                </div>
              </div>

              <div class="form-group flex flex-col gap-1.5" id="paxGroup">
                <label for="pax" class="text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 text-base-content/85">
                  <i data-lucide="users" class="w-4 h-4 text-primary"></i>No. of Pax
                </label>
                <div class="flex gap-2" id="paxChips"></div>
                <input type="hidden" id="pax" name="participants" disabled />
                <div class="invalid-feedback text-error text-xs hidden items-center gap-1 mt-0.5">
                  <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i>Please select the number of participants.
                </div>
              </div>

              <div class="form-group flex flex-col gap-1.5" id="vehicleGroup">
                <label class="text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 text-base-content/85">
                  <i data-lucide="car" class="w-4 h-4 text-primary"></i><span id="vehicleLabel">Vehicle Type</span>
                </label>
                <div class="flex flex-wrap gap-2" id="vehicleChips"></div>
                <input type="hidden" id="vehicle" name="service" disabled />
                <div class="invalid-feedback text-error text-xs hidden items-center gap-1 mt-0.5">
                  <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i><span id="vehicleError">Please select vehicle type.</span>
                </div>
              </div>

              <div class="form-group flex flex-col gap-1.5 hidden" id="vehicleCountGroup">
                <label for="vehicleCount" class="text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 text-base-content/85">
                  <i data-lucide="hash" class="w-4 h-4 text-primary"></i>No. of Vehicles
                </label>
                <input type="number" class="input input-bordered w-full focus:input-primary transition-all duration-200" id="vehicleCount" name="vehicleCount" min="1" max="50" placeholder="e.g. 2" disabled />
                <div class="invalid-feedback text-error text-xs hidden items-center gap-1 mt-0.5">
                  <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i>Please enter the number of vehicles.
                </div>
              </div>

              <div class="form-group flex flex-col gap-1.5">
                <label for="subject" class="text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 text-base-content/85">
                  <i data-lucide="text" class="w-4 h-4 text-primary"></i>Request Title
                </label>
                <input type="text" class="input input-bordered w-full focus:input-primary transition-all duration-200" id="subject" name="subject" placeholder="e.g. Annual Strategy Meeting" maxlength="200" required />
                <div class="invalid-feedback text-error text-xs hidden items-center gap-1 mt-0.5">
                  <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i>Please enter a request title.
                </div>
              </div>

              <div class="form-group flex flex-col gap-1.5">
                <label for="description" class="text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 text-base-content/85">
                  <i data-lucide="align-left" class="w-4 h-4 text-primary"></i>Remarks
                </label>
                <textarea class="textarea textarea-bordered w-full focus:textarea-primary min-h-[120px] transition-all duration-200" id="description" name="description" rows="5" maxlength="2000" placeholder="e.g. projector needed, reserve 2 parking slots…" aria-describedby="descriptionCounter"></textarea>
                <div class="flex justify-between items-center mt-1">
                  <div class="invalid-feedback text-error text-xs hidden items-center gap-1">
                    <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i>Please enter remarks.
                  </div>
                  <div id="descriptionCounter" class="text-xs text-base-content/50 ml-auto" aria-live="polite">0 / 2000</div>
                </div>
              </div>

              <div class="flex flex-col gap-1.5">
                <label class="text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 text-base-content/85">
                  <i data-lucide="calendar" class="w-4 h-4 text-primary"></i>Booking Date & Time
                </label>
                <div class="form-group flex flex-col gap-1.5">
                  <label for="bookingDate" class="text-[11px] text-base-content/70 font-medium">Date</label>
                  <input type="date" id="bookingDate" name="date" class="input input-bordered w-full focus:input-primary transition-all duration-200" required />
                  <div class="invalid-feedback text-error text-xs hidden items-center gap-1 mt-0.5">
                    <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i>Select a valid date.
                  </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div class="form-group flex flex-col gap-1.5">
                    <label for="startTime" class="text-[11px] text-base-content/70 font-medium">Start Time</label>
                    <select class="select select-bordered w-full focus:select-primary transition-all duration-200" id="startTime" name="startTime" required>
                      <option value="" selected disabled>Select time…</option>
                    </select>
                    <div class="invalid-feedback text-error text-xs hidden items-center gap-1 mt-0.5">
                      <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i>Please select a start time.
                    </div>
                  </div>
                  <div class="form-group flex flex-col gap-1.5">
                    <label for="endTime" class="text-[11px] text-base-content/70 font-medium">End Time</label>
                    <select class="select select-bordered w-full focus:select-primary transition-all duration-200" id="endTime" name="endTime" required>
                      <option value="" selected disabled>Select time…</option>
                    </select>
                    <div class="invalid-feedback text-error text-xs hidden items-center gap-1 mt-0.5">
                      <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i>Please select an end time.
                    </div>
                  </div>
                </div>
              </div>

              <div class="flex items-stretch gap-2 sm:gap-3 mt-8">
                <button type="submit" class="btn btn-primary flex-1 min-h-11 shadow-lg" id="submitBtn">
                  <span id="submitBtnText">Submit Ticket</span>
                  <span id="submitBtnSpinner" class="loading loading-spinner loading-sm hidden"></span>
                </button>
                <button type="reset" class="btn btn-outline min-h-11" id="resetBtn" aria-label="Clear form" title="Clear form">
                  <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                  <span class="hidden sm:inline">Clear</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>

    <dialog class="modal modal-bottom sm:modal-middle" id="confirmModal">
      <div class="modal-box border border-base-300/40 shadow-2xl">
        <h3 class="font-bold text-lg flex items-center gap-2 text-primary font-title">
          <i data-lucide="send" class="w-5 h-5"></i>Submit ticket?
        </h3>
        <p class="py-4 text-sm text-base-content/80">
          Your ticket will be sent to the support mailbox. Would you like to continue?
        </p>
        <div class="modal-action">
          <button type="button" class="btn btn-outline" id="modalCancelBtn">Cancel</button>
          <button type="button" class="btn btn-primary" id="confirmSubmitBtn">Yes, submit</button>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop bg-black/30 backdrop-blur-[2px]">
        <button>close</button>
      </form>
    </dialog>

    <script src="https://cdn.jsdelivr.net/npm/lucide/dist/umd/lucide.min.js"></script>
    <script>
      import "../../scripts/form.js";
    </script>
  </body>
</html>
